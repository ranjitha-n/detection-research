SigninLogs
| where ResultType != "0"
| summarize
    FailedLogins = count(),
    DistinctUsers = dcount(UserPrincipalName),
    TargetedUsers = make_set(UserPrincipalName, 100)
    by IPAddress, bin(TimeGenerated, 10m)
| where DistinctUsers >= 5
| project TimeGenerated, IPAddress, FailedLogins, DistinctUsers, TargetedUsers
| order by DistinctUsers desc