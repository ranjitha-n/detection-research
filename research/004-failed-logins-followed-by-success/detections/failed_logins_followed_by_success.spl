index="detection_lab"
| sort 0 _time
| transaction user maxspan=10m
| eval failures=mvcount(mvfilter(result="FAIL"))
| eval successes=mvcount(mvfilter(result="SUCCESS"))
| eval first_result=mvindex(result,0)
| eval last_result=mvindex(result,-1)
| where failures >= 3
| eval outcome=case(
    first_result="FAIL" AND last_result="SUCCESS","Failures followed by Success",
    successes=0,"Failures Only",
    1=1,"Other Sequence"
)
| table user failures successes first_result last_result src_ip location duration outcome